{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product in the inventory catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "barcode": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "unitType": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "openingStock": { "type": "number" },
        "currentStock": { "type": "number" },
        "stockAdded": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "status": { "type": "string" },
        "businessId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "sellingPrice"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed point of sale transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "amountTendered": { "type": "number" },
        "change": { "type": "number" },
        "cashierId": { "type": "string" },
        "cashierName": { "type": "string" },
        "businessDayId": { "type": "string" },
        "businessId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "items", "totalAmount", "paymentMethod", "cashierId"]
    },
    "RestaurantOrder": {
      "title": "RestaurantOrder",
      "description": "Order taken by waiter or cashier for a table or spot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "tableId": { "type": "string" },
        "tableName": { "type": "string" },
        "customerName": { "type": "string" },
        "notes": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "totalAmount": { "type": "number" },
        "orderStatus": { "type": "string" },
        "kitchenStatus": { "type": "string" },
        "waiterId": { "type": "string" },
        "waiterName": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "businessDayId": { "type": "string" },
        "businessId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "orderNumber", "tableId", "tableName", "items", "totalAmount", "orderStatus", "waiterId"]
    },
    "RestaurantTable": {
      "title": "RestaurantTable",
      "description": "Dining tables and bar service spots",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "zone": { "type": "string" },
        "seats": { "type": "number" },
        "status": { "type": "string" },
        "businessId": { "type": "string" },
        "currentOrderId": { "type": "string" },
        "currentWaiterId": { "type": "string" },
        "currentWaiterName": { "type": "string" }
      },
      "required": ["id", "name", "zone", "status"]
    }
  },
  "firestore": {
    "/businesses/{businessId}/products/{productId}": {
      "schema": "Product",
      "description": "Business inventory product catalog"
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Point of sale completed receipts"
    },
    "/businesses/{businessId}/orders/{orderId}": {
      "schema": "RestaurantOrder",
      "description": "Live restaurant orders sent to cashier"
    },
    "/businesses/{businessId}/tables/{tableId}": {
      "schema": "RestaurantTable",
      "description": "Restaurant tables and bar counters"
    }
  }
}
